{
  "installCommand": "npm install --include=optional",
  "functions": {
    "app/api/**/*": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/node-name-embedding",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/trans-e-embedding",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/topic-space-drive-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/pdf-extraction",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/kg-extraction",
      "schedule": "*/1 * * * *"
    }
  ]
}
